rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funções auxiliares
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isGroupMember(groupId) {
      return isSignedIn() && 
        request.auth.uid in get(/databases/$(database)/documents/grupos/$(groupId)).data.memberIds;
    }

    // Regras para Usuários
    match /users/{userId} {
      allow read, update, delete: if isOwner(userId);
      allow create: if isSignedIn();
      
      // Subcoleção de Notificações
      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isSignedIn(); // Permite que outros usuários enviem notificações
      }
    }

    // Regras para Grupos
    match /grupos/{groupId} {
      // Permite criar grupo se estiver logado
      allow create: if isSignedIn();
      
      // Permite ler se for membro OU se estiver tentando entrar via código
      allow read: if isSignedIn() && (
        (resource != null && request.auth.uid in resource.data.memberIds) ||
        // Permite a busca inicial por código de convite para quem não é membro
        true 
      );
      
      allow update, delete: if isGroupMember(groupId);

      // Subcoleções do Grupo (Listas, Mercados, Preços)
      match /listas/{listaId} {
        allow read, write: if isGroupMember(groupId);
        
        match /itens/{itemId} {
          allow read, write: if isGroupMember(groupId);
        }
      }
      
      match /mercados/{mercadoId} {
        allow read, write: if isGroupMember(groupId);
      }
      
      match /precos/{precoId} {
        allow read, write: if isGroupMember(groupId);
      }
    }
  }
}
